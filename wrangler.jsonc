{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paluca",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": {
    "bindings": [{ "name": "PALUCA_STORE", "class_name": "PalucaStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PalucaStore"] }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "paluca-uploads" }],
  "observability": { "enabled": true }
}
